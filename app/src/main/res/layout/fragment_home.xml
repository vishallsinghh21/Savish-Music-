<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E13"
    tools:context="dev.brahmkshatriya.echo.ui.main.HomeFragment">

    <!-- Top Dynamic Brand Tint Background -->
    <View
        android:id="@+id/view_brand_glow"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:alpha="0.22"
        android:background="@drawable/bg_glass_capsule" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Global Sync Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_sync_status"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_glass_capsule"
                    android:backgroundTint="#00E676" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.08"
                    android:text="GLOBAL SYNC ACTIVE"
                    android:textColor="#00E676"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Title & Profile Row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Savish Music"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Profile Avatar: Tap for Settings, Long-press for Gallery -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_profile_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#161E24"
                    android:clickable="true"
                    android:contentDescription="Profile and Settings"
                    android:focusable="true"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_play_arrow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1.5dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Scrollable Platform Capsules -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_capsules_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- All Media Capsule -->
                    <TextView
                        android:id="@+id/capsule_all"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_capsule"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="• All media"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- YouTube Capsule -->
                    <TextView
                        android:id="@+id/capsule_youtube"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_capsule"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="• YouTube"
                        android:textColor="#B0BEC5"
                        android:textSize="13sp" />

                    <!-- Spotify Capsule -->
                    <TextView
                        android:id="@+id/capsule_spotify"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_capsule"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="• Spotify"
                        android:textColor="#B0BEC5"
                        android:textSize="13sp" />

                    <!-- JioSaavn Capsule -->
                    <TextView
                        android:id="@+id/capsule_saavn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_capsule"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="• JioSaavn"
                        android:textColor="#B0BEC5"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- In-line Glass Search Bar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_bar">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="14dp"
                    android:contentDescription="Search Icon"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#8090A0" />

                <EditText
                    android:id="@+id/et_home_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="14dp"
                    android:background="@android:color/transparent"
                    android:hint="Search songs in Savish All media..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#607080"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Welcome User Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back,"
                    android:textColor="#8090A0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_user_playlist_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Your Playlists • Vishal Singh"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Feed / Speed Dial Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:contentDescription="@string/home"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="100dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_shelf_lists" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/appBarOutline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
